library(biomaRt)
setwd("/data/Priyanka/Lethality/Tissue-wise/Breast-BRCA_Normal/Preprocessed-Breast-BRCA_Normal/")
mart <- useDataset("hsapiens_gene_ensembl", useMart("ensembl"))
Ens_df <- as.data.frame(read.delim("Exp-Breast-BRCA_Normal.txt", header = FALSE))
Ens_df$V1 <- sub("\\..*","\\", Ens_df$V1, perl=TRUE)
Ens_df
####### Breast Normal ###########
library(biomaRt)
setwd("/Users/shshreya/Academics/DDP/Lethality/Tissue-wise/Breast-BRCA_Normal/Preprocessed-Breast-BRCA_Normal/")
mart <- useDataset("hsapiens_gene_ensembl", useMart("ensembl"))
Ens_df <- as.data.frame(read.delim("Exp-Breast-BRCA_Normal.txt", header = FALSE))
Ens_df$V1 <- sub("\\..*","\\", Ens_df$V1, perl=TRUE)
Ens_df
Ensembl_Ids_iso = getBM(attributes=c('ensembl_gene_id', 'entrezgene_id', 'external_gene_name'),
filters = 'ensembl_gene_id',
values = Ens_df,
mart = mart, uniqueRows = FALSE)
Ensembl_Ids_iso
#merge(x, y, by.x = x, by.y = y)
output <- as.data.frame(merge(Ens_df, Ensembl_Ids_iso, by.x = "V1", by.y = "ensembl_gene_id"))
output
Entrez_table <- data.frame(output[,c(3,2)])
write.table(Entrez_table, file = "Entrez-Exp-Breast-BRCA_Normal.txt", sep = "\t", row.names = FALSE)
